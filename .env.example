# Copy to .env and fill in what you actually use.
# Every service below has an offline fallback, so the app runs with none of them.

# ---------------------------------------------------------------- model
# anthropic | openai | ollama | echo
# "echo" runs fully offline with canned responses (used by the test suite).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
LLM_API_KEY=
LLM_TEMPERATURE=0.4

# ----------------------------------------------------------- embeddings
# sentence_transformers | openai | hashing
# multilingual-e5-small puts Hindi and English in one vector space, which is
# what lets a Hindi question retrieve from an English textbook.
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# ------------------------------------------------------------------ voice
# edge | elevenlabs | gtts | espeak | silent
# edge-tts is free, needs no key, and has good hi-IN / ta-IN / bn-IN voices.
TTS_PROVIDER=edge
TTS_API_KEY=
TTS_SPEED=1.0

# ----------------------------------------------------------------- avatar
# did | heygen | sadtalker | static
# "static" is the offline procedural talking head — no key, no GPU.
AVATAR_PROVIDER=static
AVATAR_API_KEY=
AVATAR_PRESENTER_ID=
# D-ID and HeyGen fetch the audio over HTTP, so they need a public media root:
# MEDIA_PUBLIC_BASE=https://your-tunnel.example.com/media
# AVATAR_PORTRAIT_URL=https://.../teacher.png
# SADTALKER_DIR=/opt/SadTalker

# ------------------------------------------------------------------ video
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720
VIDEO_FPS=24
VIDEO_AVATAR_SCALE=0.20
VIDEO_BURN_SUBTITLES=true
FFMPEG_BIN=ffmpeg

# -------------------------------------------------------------------- rag
RAG_CHUNK_TOKENS=320
RAG_CHUNK_OVERLAP=60
RAG_TOP_K=8
RAG_DENSE_WEIGHT=0.65
RAG_MIN_GROUNDING=0.35

# ------------------------------------------------------------------- app
DATABASE_URL=sqlite:///./data/ai_teacher.db
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=80

# ------------------------------------------------------- speech-to-text
# faster_whisper | openai | groq | disabled
# Lets students answer out loud instead of typing. faster_whisper runs
# locally with no key; "small" is a good speed/accuracy balance on CPU.
STT_PROVIDER=faster_whisper
STT_MODEL=small
STT_API_KEY=
